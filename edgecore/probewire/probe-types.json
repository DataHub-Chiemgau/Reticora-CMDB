{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reticora.example/api/probe-types.json",
  "title": "Reticora monitoring probe types",
  "description": "Register of the monitoring probe types (PRT-01, E-154): key, status, defaults, system limits, credential namespaces, collector capabilities and parameter schema. Server and collector validate probes against this contract. Times in seconds, rates in checks per second.",
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "min_interval_s",
        "default_interval_s",
        "max_interval_s",
        "min_timeout_s",
        "default_timeout_s",
        "max_timeout_s",
        "default_down_count",
        "default_up_count",
        "max_parallel_per_target",
        "max_parallel_per_collector",
        "max_rate_per_collector",
        "max_probes_per_target",
        "max_payload_bytes",
        "max_rows",
        "credential_namespaces",
        "capabilities",
        "params"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "available"
          ],
          "description": "planned types cannot be created (422); type work packages set available."
        },
        "min_interval_s": {
          "type": "integer",
          "minimum": 1,
          "description": "Shortest interval in seconds."
        },
        "default_interval_s": {
          "type": "integer",
          "minimum": 1,
          "description": "Interval without override."
        },
        "max_interval_s": {
          "type": "integer",
          "minimum": 1,
          "description": "Longest interval (default 86400)."
        },
        "min_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "description": "Shortest timeout."
        },
        "default_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "description": "Timeout without override; below default_interval_s."
        },
        "max_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "description": "Longest timeout; per probe timeout < interval."
        },
        "default_down_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "default_up_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_parallel_per_target": {
          "type": "integer",
          "minimum": 1,
          "description": "Concurrent checks per target."
        },
        "max_parallel_per_collector": {
          "type": "integer",
          "minimum": 1,
          "description": "Concurrent checks per collector."
        },
        "max_rate_per_collector": {
          "type": "integer",
          "minimum": 1,
          "description": "Checks per second per collector."
        },
        "max_probes_per_target": {
          "type": "integer",
          "minimum": 1,
          "description": "Probes of this type per target."
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Payload or response cap in bytes."
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "description": "Row cap per check (values, OIDs, sessions)."
        },
        "credential_namespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 32
          },
          "maxItems": 8,
          "description": "Credential namespaces the type needs (none: empty)."
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "icmp",
              "ipv6",
              "privileged_udp_ports",
              "time_sync"
            ]
          },
          "maxItems": 8,
          "description": "Collector capabilities the type needs (PRT-18)."
        },
        "params": {
          "type": "object",
          "description": "JSON Schema of the type parameters."
        }
      }
    }
  },
  "types": {
    "icmp": {
      "status": "available",
      "min_interval_s": 10,
      "default_interval_s": 30,
      "max_interval_s": 3600,
      "min_timeout_s": 1,
      "default_timeout_s": 10,
      "max_timeout_s": 10,
      "default_down_count": 5,
      "default_up_count": 1,
      "max_parallel_per_target": 1,
      "max_parallel_per_collector": 256,
      "max_rate_per_collector": 1000,
      "max_probes_per_target": 4,
      "max_payload_bytes": 1472,
      "max_rows": 1,
      "credential_namespaces": [],
      "capabilities": [
        "icmp"
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3,
            "description": "Echo requests per check."
          },
          "spacing_ms": {
            "type": "integer",
            "minimum": 200,
            "maximum": 1000,
            "default": 1000,
            "description": "Gap between echo requests; (count - 1) x spacing_ms must stay below the timeout."
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1472,
            "default": 56,
            "description": "ICMP payload size in bytes (at most 1452 over IPv6)."
          },
          "family": {
            "type": "string",
            "enum": [
              "auto",
              "v4",
              "v6"
            ],
            "default": "auto",
            "description": "Address family: auto takes the family of an address literal, for a host name IPv6 first, then IPv4."
          },
          "rtt_warn_ms": {
            "type": "number",
            "minimum": 1,
            "description": "Average RTT threshold for degraded; no default."
          },
          "loss_warn": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.5,
            "description": "Loss threshold for degraded (fraction)."
          }
        }
      }
    },
    "tcp": {
      "status": "available",
      "min_interval_s": 10,
      "default_interval_s": 60,
      "max_interval_s": 86400,
      "min_timeout_s": 1,
      "default_timeout_s": 5,
      "max_timeout_s": 30,
      "default_down_count": 3,
      "default_up_count": 1,
      "max_parallel_per_target": 2,
      "max_parallel_per_collector": 128,
      "max_rate_per_collector": 500,
      "max_probes_per_target": 32,
      "max_payload_bytes": 1024,
      "max_rows": 1,
      "credential_namespaces": [],
      "capabilities": [],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "port"
        ],
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "TCP port of the target (required)."
          },
          "send": {
            "type": "string",
            "maxLength": 512,
            "description": "String sent after connect, at most 256 bytes after the escapes \\r, \\n, \\t and \\\\ are decoded (the escaped form may therefore be up to 512 characters). Without send nothing is sent."
          },
          "expect": {
            "type": "string",
            "maxLength": 1024,
            "description": "RE2 regular expression matched against the answer (read at most 1 KiB or until the timeout). Without expect nothing is read."
          },
          "family": {
            "type": "string",
            "enum": [
              "auto",
              "v4",
              "v6"
            ],
            "default": "auto",
            "description": "Address family of the connection."
          },
          "rtt_warn_ms": {
            "type": "number",
            "minimum": 1,
            "description": "Connect time threshold for degraded; no default."
          }
        }
      }
    },
    "http": {
      "status": "available",
      "min_interval_s": 30,
      "default_interval_s": 60,
      "max_interval_s": 86400,
      "min_timeout_s": 1,
      "default_timeout_s": 10,
      "max_timeout_s": 60,
      "default_down_count": 3,
      "default_up_count": 1,
      "max_parallel_per_target": 2,
      "max_parallel_per_collector": 64,
      "max_rate_per_collector": 100,
      "max_probes_per_target": 32,
      "max_payload_bytes": 1048576,
      "max_rows": 1,
      "credential_namespaces": [
        "http"
      ],
      "capabilities": [],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "URL to check (required): http or https with a host."
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "HEAD"
            ],
            "default": "GET",
            "description": "GET or HEAD; every other method is refused."
          },
          "expected_status": {
            "type": "array",
            "maxItems": 20,
            "default": [
              "200-399"
            ],
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 7
            },
            "description": "Expected status codes and ranges (\"200\", \"200-299\"), each 100 to 599."
          },
          "body_regex": {
            "type": "string",
            "maxLength": 1024,
            "description": "RE2 expression the body must match (GET only), read up to max_body."
          },
          "max_body": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "default": 65536,
            "description": "Bytes of the body read for body_regex; the rest is cut off without error."
          },
          "follow_redirects": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "default": 0,
            "description": "Redirects followed; with 0 a redirect is the answer, a further redirect is fail redirect_limit."
          },
          "headers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Accept": {
                "type": "string",
                "maxLength": 256
              },
              "User-Agent": {
                "type": "string",
                "maxLength": 256
              },
              "Host": {
                "type": "string",
                "maxLength": 255
              }
            },
            "description": "Request headers; only Accept, User-Agent and Host."
          },
          "cert_warn_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "default": 21,
            "description": "Remaining certificate lifetime below which an ok check gets the warn code cert_expiring."
          },
          "rtt_warn_ms": {
            "type": "integer",
            "minimum": 1,
            "description": "Total time above which the probe is degraded (threshold)."
          }
        }
      }
    },
    "snmp_status": {
      "status": "available",
      "min_interval_s": 30,
      "default_interval_s": 60,
      "max_interval_s": 86400,
      "min_timeout_s": 1,
      "default_timeout_s": 5,
      "max_timeout_s": 15,
      "default_down_count": 3,
      "default_up_count": 1,
      "max_parallel_per_target": 1,
      "max_parallel_per_collector": 32,
      "max_rate_per_collector": 200,
      "max_probes_per_target": 4,
      "max_payload_bytes": 65536,
      "max_rows": 20,
      "credential_namespaces": [
        "snmp"
      ],
      "capabilities": [],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "checks": {
            "type": "array",
            "maxItems": 20,
            "description": "OID checks (at most 20); a violated check is down or degraded after its severity.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "oid",
                "op",
                "value"
              ],
              "properties": {
                "oid": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 128,
                  "description": "OID of a scalar in dotted form, e.g. 1.3.6.1.2.1.1.7.0."
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "ne",
                    "lt",
                    "gt",
                    "in",
                    "regex"
                  ],
                  "description": "lt and gt compare numbers; in takes a comma-separated list; regex is RE2 with at most 256 characters."
                },
                "value": {
                  "type": "string",
                  "maxLength": 1024,
                  "description": "Expected value."
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "degraded",
                    "down"
                  ],
                  "default": "down",
                  "description": "State of a violated check."
                }
              }
            }
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 161,
            "description": "UDP port of the agent; a port in the target wins over this parameter."
          },
          "timeout_s": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15,
            "description": "Timeout of one SNMP request; absent: the probe timeout divided by the attempts."
          },
          "retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "default": 0,
            "description": "Retries of an unanswered SNMP request within the probe timeout."
          }
        }
      }
    },
    "snmp_if": {
      "status": "planned",
      "min_interval_s": 60,
      "default_interval_s": 300,
      "max_interval_s": 86400,
      "min_timeout_s": 1,
      "default_timeout_s": 10,
      "max_timeout_s": 60,
      "default_down_count": 3,
      "default_up_count": 1,
      "max_parallel_per_target": 1,
      "max_parallel_per_collector": 16,
      "max_rate_per_collector": 50,
      "max_probes_per_target": 4,
      "max_payload_bytes": 1048576,
      "max_rows": 1024,
      "credential_namespaces": [
        "snmp"
      ],
      "capabilities": [],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name_pattern": {
            "type": "string",
            "maxLength": 256
          },
          "if_index": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "maxItems": 1024
          },
          "admin_up_only": {
            "type": "boolean",
            "default": true
          },
          "critical": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "maxItems": 1024
          },
          "util_warn_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "snmp_custom": {
      "status": "planned",
      "min_interval_s": 60,
      "default_interval_s": 300,
      "max_interval_s": 86400,
      "min_timeout_s": 1,
      "default_timeout_s": 10,
      "max_timeout_s": 60,
      "default_down_count": 3,
      "default_up_count": 1,
      "max_parallel_per_target": 1,
      "max_parallel_per_collector": 16,
      "max_rate_per_collector": 100,
      "max_probes_per_target": 8,
      "max_payload_bytes": 65536,
      "max_rows": 256,
      "credential_namespaces": [
        "snmp"
      ],
      "capabilities": [],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "oids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "maxItems": 32
          },
          "warn": {
            "type": "number"
          },
          "crit": {
            "type": "number"
          }
        }
      }
    },
    "redfish": {
      "status": "available",
      "min_interval_s": 60,
      "default_interval_s": 300,
      "max_interval_s": 86400,
      "min_timeout_s": 1,
      "default_timeout_s": 15,
      "max_timeout_s": 60,
      "default_down_count": 3,
      "default_up_count": 1,
      "max_parallel_per_target": 1,
      "max_parallel_per_collector": 8,
      "max_rate_per_collector": 20,
      "max_probes_per_target": 2,
      "max_payload_bytes": 1048576,
      "max_rows": 256,
      "credential_namespaces": [
        "redfish"
      ],
      "capabilities": [],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 443,
            "description": "HTTPS port of the Redfish service."
          },
          "system_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Id of the computer system (letters, digits, '.', '_', '-'); empty reads the first member of Systems."
          },
          "chassis_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "maxItems": 8,
            "description": "Ids of the chassis to read; empty reads every chassis within the limit of 20 resource requests per check."
          },
          "temp_warn": {
            "type": "number",
            "minimum": -50,
            "maximum": 200,
            "description": "Temperature in degrees Celsius above which the probe is degraded; overrides UpperThresholdNonCritical of the device."
          },
          "temp_crit": {
            "type": "number",
            "minimum": -50,
            "maximum": 200,
            "description": "Temperature in degrees Celsius above which the probe is down; overrides UpperThresholdCritical of the device."
          }
        }
      }
    },
    "bgp": {
      "status": "planned",
      "min_interval_s": 30,
      "default_interval_s": 60,
      "max_interval_s": 86400,
      "min_timeout_s": 1,
      "default_timeout_s": 10,
      "max_timeout_s": 60,
      "default_down_count": 3,
      "default_up_count": 1,
      "max_parallel_per_target": 1,
      "max_parallel_per_collector": 16,
      "max_rate_per_collector": 50,
      "max_probes_per_target": 2,
      "max_payload_bytes": 1048576,
      "max_rows": 4096,
      "credential_namespaces": [
        "snmp",
        "gnmi"
      ],
      "capabilities": [],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_peers": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "maxItems": 256
          },
          "source": {
            "type": "string",
            "enum": [
              "snmp",
              "gnmi"
            ],
            "default": "snmp",
            "description": "Data source (SNMP MIB or gNMI/OpenConfig)."
          }
        }
      }
    },
    "ospf": {
      "status": "available",
      "min_interval_s": 60,
      "default_interval_s": 60,
      "max_interval_s": 86400,
      "min_timeout_s": 1,
      "default_timeout_s": 10,
      "max_timeout_s": 30,
      "default_down_count": 3,
      "default_up_count": 1,
      "max_parallel_per_target": 1,
      "max_parallel_per_collector": 16,
      "max_rate_per_collector": 50,
      "max_probes_per_target": 2,
      "max_payload_bytes": 1048576,
      "max_rows": 1000,
      "credential_namespaces": [
        "snmp"
      ],
      "capabilities": [],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "neighbors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "router_id"
              ],
              "properties": {
                "router_id": {
                  "type": "string",
                  "minLength": 7,
                  "maxLength": 15,
                  "description": "Router ID of the neighbor in dotted IPv4 form."
                },
                "version": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 3,
                  "description": "OSPF version 2 or 3; absent matches either."
                }
              }
            },
            "maxItems": 1000,
            "description": "Expected neighbors; each must be present and full, else the probe is down."
          },
          "min_neighbors": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Fewer neighbors in state full is degraded."
          },
          "max_neighbors": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 1000,
            "description": "Rows read per check; more truncate the walk."
          }
        }
      }
    },
    "isis": {
      "status": "available",
      "min_interval_s": 60,
      "default_interval_s": 60,
      "max_interval_s": 86400,
      "min_timeout_s": 1,
      "default_timeout_s": 10,
      "max_timeout_s": 30,
      "default_down_count": 3,
      "default_up_count": 1,
      "max_parallel_per_target": 1,
      "max_parallel_per_collector": 16,
      "max_rate_per_collector": 50,
      "max_probes_per_target": 2,
      "max_payload_bytes": 1048576,
      "max_rows": 1000,
      "credential_namespaces": [
        "snmp"
      ],
      "capabilities": [],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "adjacencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "system_id"
              ],
              "properties": {
                "system_id": {
                  "type": "string",
                  "minLength": 12,
                  "maxLength": 17,
                  "description": "System ID of the neighbor, six octets (e.g. 1921.6800.1001)."
                },
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2,
                  "description": "IS-IS level 1 or 2; an L1L2 adjacency serves both, absent matches any."
                }
              }
            },
            "maxItems": 1000,
            "description": "Expected adjacencies; each must be present and up, else the probe is down."
          },
          "min_adjacencies": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Fewer adjacencies up is degraded."
          },
          "max_adjacencies": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 1000,
            "description": "Rows read per check; more truncate the walk."
          }
        }
      }
    },
    "bfd": {
      "status": "available",
      "min_interval_s": 30,
      "default_interval_s": 60,
      "max_interval_s": 86400,
      "min_timeout_s": 1,
      "default_timeout_s": 5,
      "max_timeout_s": 30,
      "default_down_count": 3,
      "default_up_count": 1,
      "max_parallel_per_target": 1,
      "max_parallel_per_collector": 16,
      "max_rate_per_collector": 50,
      "max_probes_per_target": 2,
      "max_payload_bytes": 1048576,
      "max_rows": 1000,
      "credential_namespaces": [
        "snmp"
      ],
      "capabilities": [],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "maxItems": 1000,
            "description": "Neighbor addresses (IPv4 or IPv6) of the expected sessions, 1 to 1000; exactly one of sessions and all."
          },
          "all": {
            "type": "boolean",
            "description": "Every session of the table is expected up (adminDown excepted); exactly one of sessions and all."
          }
        }
      }
    },
    "optical": {
      "status": "available",
      "min_interval_s": 60,
      "default_interval_s": 300,
      "max_interval_s": 86400,
      "min_timeout_s": 1,
      "default_timeout_s": 15,
      "max_timeout_s": 60,
      "default_down_count": 3,
      "default_up_count": 1,
      "max_parallel_per_target": 1,
      "max_parallel_per_collector": 8,
