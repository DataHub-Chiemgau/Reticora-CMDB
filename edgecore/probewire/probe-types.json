{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reticora.example/api/probe-types.json",
  "title": "Reticora monitoring probe types",
  "description": "Register of the monitoring probe types (PRT-01, E-154): key, status, defaults, system limits, credential namespaces, collector capabilities and parameter schema. Server and collector validate probes against this contract. Times in seconds, rates in checks per second.",
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "min_interval_s",
        "default_interval_s",
        "max_interval_s",
        "min_timeout_s",
        "default_timeout_s",
        "max_timeout_s",
        "default_down_count",
        "default_up_count",
        "max_parallel_per_target",
        "max_parallel_per_collector",
        "max_rate_per_collector",
        "max_probes_per_target",
        "max_payload_bytes",
        "max_rows",
        "credential_namespaces",
        "capabilities",
        "params"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "available"
          ],
          "description": "planned types cannot be created (422); type work packages set available."
        },
        "min_interval_s": {
          "type": "integer",
          "minimum": 1,
          "description": "Shortest interval in seconds."
        },
        "default_interval_s": {
          "type": "integer",
          "minimum": 1,
          "description": "Interval without override."
        },
        "max_interval_s": {
          "type": "integer",
          "minimum": 1,
          "description": "Longest interval (default 86400)."
        },
        "min_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "description": "Shortest timeout."
        },
        "default_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "description": "Timeout without override; below default_interval_s."
        },
        "max_timeout_s": {
          "type": "integer",
          "minimum": 1,
          "description": "Longest timeout; per probe timeout < interval."
        },
        "default_down_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "default_up_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_parallel_per_target": {
          "type": "integer",
          "minimum": 1,
          "description": "Concurrent checks per target."
        },
        "max_parallel_per_collector": {
          "type": "integer",
          "minimum": 1,
          "description": "Concurrent checks per collector."
        },
        "max_rate_per_collector": {
          "type": "integer",
          "minimum": 1,
          "description": "Checks per second per collector."
        },
        "max_probes_per_target": {
          "type": "integer",
          "minimum": 1,
          "description": "Probes of this type per target."
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Payload or response cap in bytes."
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "description": "Row cap per check (values, OIDs, sessions)."
        },
        "credential_namespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 32
          },
          "maxItems": 8,
          "description": "Credential namespaces the type needs (none: empty)."
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "icmp",
              "ipv6",
              "privileged_udp_ports",
              "time_sync"
            ]
          },
          "maxItems": 8,
          "description": "Collector capabilities the type needs (PRT-18)."
        },
        "params": {
          "type": "object",
          "description": "JSON Schema of the type parameters."
        }
      }
    }
  },
  "types": {
    "icmp": {
      "status": "available",
      "min_interval_s": 10,
      "default_interval_s": 30,
      "max_interval_s": 3600,
      "min_timeout_s": 1,
      "default_timeout_s": 10,
      "max_timeout_s": 10,
      "default_down_count": 5,
      "default_up_count": 1,
      "max_parallel_per_target": 1,
      "max_parallel_per_collector": 256,
      "max_rate_per_collector": 1000,
      "max_probes_per_target": 4,
      "max_payload_bytes": 1472,
      "max_rows": 1,
      "credential_namespaces": [],
      "capabilities": [
        "icmp"
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3,
            "description": "Echo requests per check."
          },
          "spacing_ms": {
            "type": "integer",
            "minimum": 10,
            "maximum": 10000,
            "default": 1000,
            "description": "Gap between echo requests."
          },
          "payload_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1472,
            "default": 56,
            "description": "ICMP payload size."
          },
          "rtt_warn_ms": {
            "type": "number",
            "minimum": 1,
            "description": "Average RTT threshold for degraded; no default."
          },
          "loss_warn": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.5,
            "description": "Loss threshold for degraded (fraction)."
          }
        }
      }
    },
    "tcp": {
      "status": "available",
      "min_interval_s": 10,
      "default_interval_s": 60,
      "max_interval_s": 86400,
      "min_timeout_s": 1,
      "default_timeout_s": 5,
      "max_timeout_s": 30,
      "default_down_count": 3,
      "default_up_count": 1,
      "max_parallel_per_target": 2,
      "max_parallel_per_collector": 128,
      "max_rate_per_collector": 500,
      "max_probes_per_target": 32,
      "max_payload_bytes": 1024,
      "max_rows": 1,
      "credential_namespaces": [],
      "capabilities": [],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "port"
        ],
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "TCP port of the target (required)."
          },
          "send": {
            "type": "string",
            "maxLength": 512,
            "description": "String sent after connect, at most 256 bytes after the escapes \\r, \\n, \\t and \\\\ are decoded (the escaped form may therefore be up to 512 characters). Without send nothing is sent."
          },
          "expect": {
            "type": "string",
            "maxLength": 1024,
            "description": "RE2 regular expression matched against the answer (read at most 1 KiB or until the timeout). Without expect nothing is read."
          },
          "family": {
            "type": "string",
            "enum": [
              "auto",
              "v4",
              "v6"
            ],
            "default": "auto",
            "description": "Address family of the connection."
          },
          "rtt_warn_ms": {
            "type": "number",
            "minimum": 1,
            "description": "Connect time threshold for degraded; no default."
          }
        }
      }
    },
