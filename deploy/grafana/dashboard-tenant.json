{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Request Rate by Tenant",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (organization_id) (rate(reticora_http_requests_total{job=\"reticora-server\", organization_id=~\"$organization_id\"}[5m]))",
          "legendFormat": "{{organization_id}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Error Rate (5xx) by Tenant",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (organization_id) (rate(reticora_http_requests_total{job=\"reticora-server\", status=~\"5..\", organization_id=~\"$organization_id\"}[5m])) / sum by (organization_id) (rate(reticora_http_requests_total{job=\"reticora-server\", organization_id=~\"$organization_id\"}[5m]))",
          "legendFormat": "{{organization_id}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Latency p95 by Tenant",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (organization_id, le) (rate(reticora_http_request_duration_seconds_bucket{job=\"reticora-server\", organization_id=~\"$organization_id\"}[5m])))",
          "legendFormat": "{{organization_id}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Requests by Path (selected tenants)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (path, status) (rate(reticora_http_requests_total{job=\"reticora-server\", organization_id=~\"$organization_id\"}[5m]))",
          "legendFormat": "{{path}} {{status}}"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["reticora", "cmdb", "tenant"],
  "templating": {
    "list": [
      {
        "name": "organization_id",
        "label": "Tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(reticora_http_requests_total, organization_id)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Reticora CMDB — Tenant Observability",
  "uid": "reticora-tenant",
  "version": 1,
  "description": "Per-tenant request rate, error rate and latency. Requires RETICORA_METRICS_TENANT_LABEL=true so the organization_id label is populated."
}
