# GraphQL BFF of the web UI (GQL-01): served by gqlgen under /bff/graphql,
# session JWT only, not part of the public REST contract. Read only:
# mutations go through REST (GQL-02). Every field checks its read
# permission and entitlement and reads through the tenant-scoped
# repositories (GQL-04).

scalar Map
scalar Time

type Query {
  "CIs of the organization in the caller's scope; at most 100 per page."
  cis(first: Int, after: String, filter: CIFilter): CIConnection!
  "One CI; null when it is not visible."
  ci(id: ID!): CI
  "Relationships of a CI."
  relationships(ciId: ID!, first: Int): [Relationship!]!
  "The signed-in user."
  currentUser: User!
  "Topology from a root CI (up to depth hops) or, without a root, of at most 2,000 CIs."
  topology(rootCiId: ID, depth: Int, ciTypeId: ID, siteId: ID): TopologyGraph!
  "Occupancy of a rack (RCK-02)."
  rackLayout(rackId: ID!): RackLayout
  "Full-text search over the entity types the caller may read."
  searchEverything(q: String!, types: [String!], first: Int): SearchResult!
  "Review items of the reconciliation queue."
  reviewInbox(status: String, kind: String, first: Int): [ReviewItem!]!
  "Jobs of the organization."
  jobs(kind: String, status: String, first: Int): [Job!]!
  "One asset with its CIs, child CIs, movements and documents (GQL-03); null when it is not visible."
  asset(id: ID!): Asset
}

input CIFilter {
  status: String
  typeId: ID
  clientId: ID
  siteId: ID
  search: String
}

type CIConnection {
  edges: [CIEdge!]!
  nodes: [CI!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type CIEdge {
  cursor: String!
  node: CI!
}

type PageInfo {
  hasNextPage: Boolean!
  endCursor: String
}

type CI {
  id: ID!
  name: String!
  status: String!
  ciTypeId: ID!
  clientId: ID
  siteId: ID
  locationId: ID
  hostname: String
  fqdn: String
  serialNumber: String
  manufacturer: String
  model: String
  managementIp: String
  lifecycleState: String
  health: String
  version: Int!
  createdAt: String!
  updatedAt: String!
  attributes: Map
  "The keys of the catalog tags of the CI, sorted (CI-07, WP-754)."
  tags: [String!]!
  "The asset the CI is linked to (AST-04)."
  assetId: ID
  "The CI this one is physically part of (AST-05)."
  parentCiId: ID
  "The child contract under the parent: configuration or standalone (AST-05)."
  childMode: String
}

type Relationship {
  id: ID!
  sourceCiId: ID!
  targetCiId: ID!
  relType: String!
  source: String
  "The source CI, batched per request (dataloader)."
  sourceCi: CI
  "The target CI, batched per request (dataloader)."
  targetCi: CI
}

type TopologyGraph {
  nodes: [TopologyNode!]!
  edges: [TopologyEdge!]!
}

type TopologyNode {
  id: ID!
  name: String!
  ciType: String!
  status: String!
  clientId: ID
  siteId: ID
  "The full CI, batched per request (dataloader)."
  ci: CI
}

type TopologyEdge {
  id: ID!
  sourceCiId: ID!
  targetCiId: ID!
  relType: String!
  source: String
}

type RackLayout {
  rack: Rack!
  mounts: [RackMount!]!
  freeFront: [Int!]!
  freeRear: [Int!]!
}

type Rack {
  id: ID!
  name: String!
  heightUnits: Int!
  roomId: ID
}

type RackMount {
  id: ID!
  ciId: ID!
  positionU: Int!
  heightU: Int!
  face: String!
  "The mounted CI, batched per request (dataloader)."
  ci: CI
}

type SearchResult {
  total: Int!
  hits: [SearchHit!]!
}

type SearchHit {
  id: ID!
  entityType: String!
  entityId: ID!
  title: String!
  summary: String
  url: String
  score: Float!
}

type ReviewItem {
  id: ID!
  kind: String!
  status: String!
  payload: Map
  escalated: Boolean!
  createdAt: String!
  "The candidate CIs, batched per request (dataloader)."
  candidates: [CI!]!
}

type Job {
  id: ID!
  kind: String!
  status: String!
  progress: Int!
  error: String
  createdAt: Time!
  finishedAt: Time
}

type User {
  id: ID!
  organizationId: ID!
  clientId: ID
}

"""
An asset with the AST-01 names (WP-739). The fields under field permissions
(RBA-07) are null when the caller may not read them; custom fields without
read access are left out. The lists are null with an error when their
permission, feature or module is missing, the asset stays.
"""
type Asset {
  id: ID!
  name: String!
  clientId: ID
  version: Int!
  createdAt: Time!
  updatedAt: Time!
  inventoryNo: String
  category: String
  status: String
  manufacturer: String
  model: String
  serialNumber: String
  purchaseDate: String
  purchasePrice: String
  currency: String
  warrantyUntil: String
  costCenter: String
  supplierId: ID
  contractId: ID
  ownerUserId: ID
  ownerTeamId: ID
  invoiceNumber: String
  rfidTag: String
  barcode: String
  locationId: ID
  lifecycleState: String
  "The primary CI (column asset.ci_id, E-122)."
  primaryCiId: ID
  notes: String
  customFields: Map
  "The keys of the catalog tags of the asset, sorted (WP-755)."
  tags: [String!]
  "The CIs linked to the asset (ci.asset_id); at most 100."
  cis(first: Int): [CI!]
  "The child CIs of the linked CIs (ci.parent_ci_id with childMode, AST-05); at most 100."
  children(first: Int): [CI!]
  "The movements of the asset in the ledger stock_movement, newest first; at most 100 per page."
  movements(first: Int, after: String): MovementConnection
  "The documents linked to the asset; at most 100."
  documents(first: Int): [Document!]
}

type MovementConnection {
  nodes: [Movement!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type Movement {
  id: ID!
  itemKind: String!
  movementType: String!
  assetId: ID
  fromLocationId: ID
  toLocationId: ID
  quantity: Float
  actorId: ID
  assigneeUserId: ID
  assigneeTeamId: ID
  reason: String
  ticketId: ID
  orderId: ID
  documentId: ID
  notes: String
  occurredAt: Time!
  createdAt: Time!
}

type Document {
  id: ID!
  title: String!
  description: String
  fileName: String!
  fileSize: Int!
  mimeType: String!
  version: Int!
  category: String!
  tags: [String!]!
  uploadedBy: ID
  scanStatus: String
  createdAt: Time!
  updatedAt: Time!
}
