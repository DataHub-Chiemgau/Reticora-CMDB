          "expires_at": "2026-12-31"
        }
      ]
    },
    "stock.movement": {
      "description": "Data frame of stock.movement. entity_id: the moved object (asset or quantity item, not the movement row, so that entity_seq orders the events per object). Origin: EVT-03. Producer: WP-274. The fields follow movement.Movement. The producer adds its fields to this definition (additionalProperties).",
      "type": "object",
      "required": ["id", "item_kind", "movement_type"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "The movement."
        },
        "item_kind": {
          "type": "string",
          "enum": ["asset", "quantity_item"],
          "description": "Kind of the moved object."
        },
        "asset_id": {
          "type": "string",
          "format": "uuid",
          "description": "The moved asset (item_kind asset)."
        },
        "quantity_item_id": {
          "type": "string",
          "format": "uuid",
          "description": "The moved quantity item (item_kind quantity_item)."
        },
        "movement_type": {
          "type": "string",
          "description": "Kind of the movement."
        },
        "quantity": {
          "type": "number",
          "description": "Moved quantity of a quantity item."
        }
      },
      "examples": [
        {
          "id": "66666666-6666-4666-8666-666666666666",
          "item_kind": "quantity_item",
          "quantity_item_id": "55555555-5555-4555-8555-555555555555",
          "movement_type": "issue",
          "quantity": 5
        }
      ]
    },
    "stock.below_minimum": {
      "description": "Data frame of stock.below_minimum. entity_id: the quantity item. Origin: NTF-05 [P2]. Producer: WP-285. The producer adds its fields to this definition (additionalProperties).",
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
