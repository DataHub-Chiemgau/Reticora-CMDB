    "asset.warranty_expiring": {
      "description": "Data frame of asset.warranty_expiring. entity_id: the asset. Origin: EVT-03 (asset.*). Producer: WP-270. The producer adds its fields to this definition (additionalProperties).",
      "type": "object",
      "required": ["id", "expires_at"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "The asset."
        },
        "client_id": {
          "type": "string",
          "format": "uuid",
          "description": "Client of the object; absent without client."
        },
        "site_id": {
          "type": "string",
          "format": "uuid",
