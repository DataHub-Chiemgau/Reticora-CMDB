    "asset.assigned": {
      "description": "Data frame of asset.assigned. entity_id: the asset. Origin: EVT-03. Producer: WP-275. The producer adds its fields to this definition (additionalProperties).",
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": {
