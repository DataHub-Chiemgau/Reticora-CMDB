          "expires_at": "2026-12-31"
        }
      ]
    },
    "contract.expiring": {
      "description": "Data frame of contract.expiring. entity_id: the contract. Origin: NTF-05 [P2]. Producer: WP-270. The producer adds its fields to this definition (additionalProperties).",
      "type": "object",
      "required": ["id", "expires_at"],
      "additionalProperties": true,
      "properties": {
