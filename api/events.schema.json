        }
      ]
    },
    "asset.deleted": {
      "description": "Data frame of asset.deleted. entity_id: the asset. Origin: EVT-03. Producer: WP-740. The producer adds its fields to this definition (additionalProperties).",
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": {
